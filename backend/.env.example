# Still Awake backend. Скопируйте в .env и поправьте под себя: cp .env.example .env
# Настоящие переменные окружения важнее .env. В Docker адрес и пути задаёт docker-compose.yml.

# Сервер. Панель — http://127.0.0.1:8080/
ADDR=127.0.0.1:8080
DB_PATH=./data/still-awake.db

# Режим разработки: первый пароль супер-админа печатается при каждом запуске.
# Без DEV_MODE пароль виден только при первом запуске, когда админ создаётся.
DEV_MODE=true

# Первый супер-админ. Пустой ADMIN_INITIAL_PASSWORD — пароль берётся из ADMIN_PASSWORD_FILE,
# а если файла нет — генерируется случайный и сохраняется туда (папка secrets/ в .gitignore).
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=123456
ADMIN_PASSWORD_FILE=./secrets/admin-password.txt
# true — вернуть супер-админу первый пароль (или выдать новый), если доступ потерян. Потом выключите.
ADMIN_RESET_PASSWORD=false

# Сроки входа: панель (часы, продлевается при активности) и игра (дни).
SESSION_TTL_HOURS=168
GAME_SESSION_TTL_DAYS=365

# Модель по умолчанию; в панели («Модель») можно сохранить другие настройки поверх этих.
# openai_compatible — LM Studio, Ollama, OpenAI и т.п.; mock — ответы-заглушки без модели.
# Пустой LLM_MODEL — взять загруженную в LM Studio модель (или первую доступную, LM Studio загрузит её сам).
LLM_MODE=openai_compatible
LLM_BASE_URL=http://127.0.0.1:1234
LLM_PATH=/v1/chat/completions
LLM_MODEL=
LLM_API_KEY=
LLM_TEMPERATURE=0.8

# Отладочный чат панели: подмена провайдера и промпта (нужно право llm.debug).
ALLOW_CLIENT_PROVIDER_OVERRIDES=true
PROVIDER_ALLOWLIST=http://127.0.0.1:1234,http://localhost:1234,https://api.openai.com,https://api.deepseek.com
ALLOW_UNSAFE_PROVIDER_URLS=false

# ТОЛЬКО ДЛЯ РАЗРАБОТКИ: INSERT/UPDATE/DELETE в SQL-консоли панели (нужно право db.write).
ADMIN_ALLOW_SQL_WRITES=false

# Править файлы панели без пересборки: путь к internal/frontend/web. Пусто — файлы, встроенные в бинарник.
FRONTEND_DIR=
