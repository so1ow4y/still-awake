# Local dev server. Keep the admin/SQL console bound to localhost.
ADDR=127.0.0.1:8080
DB_PATH=./data/still-awake.db
ADMIN_TOKEN=change-this-dev-token
ANALYTICS_TOKEN=change-this-analytics-token

# Default provider. The web UI can override these in local debug mode.
LLM_MODE=mock
LLM_BASE_URL=http://127.0.0.1:1234
LLM_PATH=/v1/chat/completions
LLM_MODEL=
LLM_API_KEY=
LLM_TEMPERATURE=0.8

# Debug provider overrides. localhost LM Studio is allowlisted here.
ALLOW_CLIENT_PROVIDER_OVERRIDES=true
PROVIDER_ALLOWLIST=http://127.0.0.1:1234,http://localhost:1234,https://api.openai.com,https://api.deepseek.com
ALLOW_UNSAFE_PROVIDER_URLS=false

# DEV ONLY. Enables INSERT/UPDATE/DELETE/DDL from the admin SQL console.
# Requires both the admin token and the per-query UI confirmation checkbox.
ADMIN_ALLOW_SQL_WRITES=true
